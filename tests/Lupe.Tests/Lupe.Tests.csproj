<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows-TFM: alle Tests (Core + Windows-Anbindung + App als Prozess). net10.0: nur die plattformneutralen Core-Tests,
         die auch unter Linux und macOS laufen (dort ohne Plattform-Assembly, also mit UnsupportedPlatform). -->
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <!-- auch unter Linux/macOS wiederherstellbar (das Windows-Ziel wird dort nur nicht ausgeführt) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lupe.Core\Lupe.Core.csproj" />
    <!-- Die Avalonia-App selbst: Oberflächentests ohne Bildschirm (Ui/, Avalonia.Headless) auf jedem System -->
    <ProjectReference Include="..\..\src\Lupe\Lupe.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <ProjectReference Include="..\..\src\Lupe.Platform.Windows\Lupe.Platform.Windows.csproj" />
  </ItemGroup>

  <!-- Linux/macOS-Anbindungen (net10.0, überall übersetzbar): Tests ihrer reinen Logik laufen überall, Tests gegen das
       echte System nur auf dem jeweiligen System (unter Linux in CI mit xvfb-run) -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lupe.Platform.Linux\Lupe.Platform.Linux.csproj" />
    <ProjectReference Include="..\..\src\Lupe.Platform.MacOS\Lupe.Platform.MacOS.csproj" />
  </ItemGroup>

  <!-- Nur unter Windows: echte Kamera, GDI-Bildschirm, SendInput, RegisterHotKey, WIC-Bilddateien, Lupe.exe als Prozess -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="App\**" />
    <Compile Remove="Screen\**" />
    <Compile Remove="Camera\CameraFactAttribute.cs;Camera\CameraProblemsTests.cs;Camera\FrameConverterTests.cs;Camera\RealCameraReentrancyTests.cs;Camera\RealCameraTests.cs;Camera\CamerasTests.cs" />
    <Compile Remove="Decoding\ImageIntegrityTests.cs;Decoding\CodecFactAttribute.cs;Decoding\ImageFileTests.cs;Decoding\TestImageFiles.cs;Decoding\ForeignCodeImages.cs;Decoding\ForeignFormatTests.cs" />
    <Compile Remove="Input\ElevationTests.cs;Input\GlobalHotkeyTests.cs;Input\KeyboardTyperDesktopTests.cs;Input\InteractiveFactAttribute.cs" />
  </ItemGroup>
</Project>
