<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lupe.Platform.Linux</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Linux-Anbindung für Lupe (X11 und Wayland): Kamera (V4L2), Bildschirm, Tippen, Tastenkürzel, Autostart.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lupe.Core\Lupe.Core.csproj" />
  </ItemGroup>

  <!-- Versionen wie Avalonia 12.1.4 (SkiaSharp 3.119.4, Tmds.DBus.Protocol 0.94.1), damit die App nur eine Fassung lädt -->
  <ItemGroup>
    <PackageReference Include="FlashCap" Version="1.12.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lupe.Tests" />
  </ItemGroup>
</Project>
