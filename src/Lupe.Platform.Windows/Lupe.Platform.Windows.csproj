<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows-SDK-Version für die WinRT-Kamera-API (Windows.Media.Capture) und Windows.Graphics.Imaging -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Lupe.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Windows-Anbindung für Lupe: Kamera (MediaCapture), Bildschirm (GDI), Tippen (SendInput), Tastenkürzel, Autostart, Bilddateien (WIC).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lupe.Core\Lupe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lupe.Tests" />
  </ItemGroup>
</Project>
