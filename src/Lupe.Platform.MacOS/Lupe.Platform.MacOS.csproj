<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lupe.Platform.MacOS</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>macOS-Anbindung für Lupe: Kamera (AVFoundation), Bildschirm, Tippen (CGEvent), Tastenkürzel (Carbon), Autostart (LaunchAgent).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lupe.Core\Lupe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lupe.Tests" />
  </ItemGroup>
</Project>
