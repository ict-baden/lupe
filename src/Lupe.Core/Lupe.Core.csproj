<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plattformneutral: alles Systemnahe steckt in Lupe.Platform.Windows/.Linux/.MacOS (siehe docs/architecture-platforms.md) -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lupe.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Erkennung, Verlauf, Einstellungen, Scan-Schleife, Tipp-Logik und Plattform-Schnittstellen für Lupe – ohne Oberfläche und ohne Systemaufrufe.</Description>
  </PropertyGroup>

  <!-- Texte der Oberfläche (Richtlinie 13): Strings.resx = Englisch (Rückfallsprache), Strings.de.resx = Deutsch.
       Die Klasse Lupe.Core.Resources.Strings erzeugt der Build, keine Designer-Datei im Repo. -->
  <PropertyGroup>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="Lupe.Core.Resources"
                      StronglyTypedClassName="Strings" StronglyTypedFileName="$(IntermediateOutputPath)Strings.g.cs" PublicClass="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZXingCpp" Version="0.5.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lupe.Tests" />
    <InternalsVisibleTo Include="Lupe.Platform.Windows" />
    <InternalsVisibleTo Include="Lupe.Platform.Linux" />
    <InternalsVisibleTo Include="Lupe.Platform.MacOS" />
  </ItemGroup>
</Project>
