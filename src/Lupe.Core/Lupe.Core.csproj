<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows-SDK-Version für die WinRT-Kamera-API (Windows.Media.Capture) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lupe.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Erkennung, Bildschirm, Kamera, Tastatureingabe, Verlauf und Einstellungen für Lupe – ohne Oberfläche.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lupe.Tests" />
  </ItemGroup>
</Project>
