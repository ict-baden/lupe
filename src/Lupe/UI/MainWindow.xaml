<Window x:Class="Lupe.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lupe.UI"
        Title="Lupe" Width="1100" Height="740" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}" UseLayoutRounding="True"
        Icon="pack://application:,,,/Lupe;component/Assets/lupe.ico">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Navigation ===================== -->
        <DockPanel Margin="12,12,8,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8,0,20">
                <Image Source="pack://application:,,,/Lupe;component/Assets/lupe.png" Width="34" Height="34"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppTitle" Text="Lupe" Style="{StaticResource BodyStrong}" FontSize="16"/>
                    <TextBlock Text="QR- und Barcodes lesen" Style="{StaticResource Caption}"/>
                </StackPanel>
            </StackPanel>

            <!-- Tastenkürzel für den Bildschirm-Scan: bereit oder belegt -->
            <Border DockPanel.Dock="Top" Margin="4,0,4,14" CornerRadius="8" Padding="12,10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusCircle" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock x:Name="StatusGlyph" Text="&#xE765;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" Text="Strg+Alt+Q" Style="{StaticResource BodyStrong}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock x:Name="StatusDetail" Text="scannt einen Ausschnitt" Style="{StaticResource Caption}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom">
                <RadioButton x:Name="NavInfo" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="Info" Checked="Nav_Checked"/>
            </StackPanel>

            <StackPanel>
                <RadioButton x:Name="NavCamera" Style="{StaticResource NavItem}" Tag="&#xE722;" Content="Kamera" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavScreen" Style="{StaticResource NavItem}" Tag="&#xE7F4;" Content="Bildschirm" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavFile" Style="{StaticResource NavItem}" Tag="&#xE8B9;" Content="Datei" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="Verlauf" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Einstellungen" Checked="Nav_Checked"/>
            </StackPanel>
        </DockPanel>

        <!-- ===================== Inhalt ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="36,26,36,14">
                <TextBlock x:Name="PageTitle" Text="Kamera" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageSubtitle" Style="{StaticResource Caption}" FontSize="13" Margin="1,2,0,0"/>
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" IsTabStop="False"/>

            <!-- ===================== Meldungen (Fußleiste wie Vitrine und Zutritt) ===================== -->
            <Border x:Name="InfoBar" Grid.Row="2" Visibility="Collapsed" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0" Padding="36,10,24,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="InfoIcon" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Top" Padding="0,2,0,0"/>
                    <TextBlock x:Name="InfoText" Grid.Column="1" Style="{StaticResource Body}" FontSize="13" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Style="{DynamicResource GhostButton}" Click="CloseInfo_Click" Margin="12,0,0,0" VerticalAlignment="Center"
                            ToolTip="Meldung schließen" AutomationProperties.Name="Meldung schließen">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
