<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Lupe.UI"
                    xmlns:svc="clr-namespace:Lupe.Services">

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <ui:EmptyToVisibleConverter x:Key="EmptyToVisible"/>
    <ui:BoolToVisibleConverter x:Key="BoolToVisible"/>

    <!-- Standard-Steuerelemente (Button, TextBox, CheckBox, DataGrid, TreeView …) stylt Fluent.
         Hier stehen nur Lupe-eigene Stile (von Zutritt und Vitrine übernommen); Farben kommen aus den Fluent-Schlüsseln.
         AccentButton, GhostButton, MultiLineBox und Table legt ThemeManager zur Laufzeit an (BasedOn Fluent). -->

    <!-- ========== Text ========== -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Margin" Value="2,22,0,8"/>
    </Style>
    <Style x:Key="BodyStrong" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <!-- Grauer Hinweis über leeren Eingabefeldern (WPF-TextBox kennt keinen Platzhalter) -->
    <Style x:Key="Placeholder" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Margin" Value="12,6,12,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Zellen in Tabellen: einzeilig, abgeschnitten, voller Text als Tooltip -->
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="700"/>
    </Style>
    <Style x:Key="CellMono" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <!-- Tabellenzeile: nur Rahmen und Zellen. Fluent legt je Zeile zusätzlich Zeilenkopf (mit zwei Greifern),
         Detailbereich und ein Raster für eingefrorene Spalten an – das braucht hier keine Tabelle, kostet aber beim
         Blättern und Filtern in großen Läufen spürbar Zeit. Gesetzt im Stil „Table“ (ThemeManager). -->
    <ControlTemplate x:Key="TableRowTemplate" TargetType="DataGridRow">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
        </Border>
    </ControlTemplate>
    <!-- Tabellenzelle: wie Fluent, aber mit Innenabstand – sonst stößt gekürzter Text ohne Lücke an die nächste
         Spalte, und Kopf und Zellen stehen nicht bündig. Der Abstand kommt aus dem Stil „Table“ (ThemeManager). -->
    <ControlTemplate x:Key="TableCellTemplate" TargetType="DataGridCell">
        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DataGridRowSelectedBackgroundThemeBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DataGridRowSelectedForegroundThemeBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ========== Fokus ========== -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="T" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"
                               Background="Transparent" TextWrapping="Wrap"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Schalter (CheckBox als ToggleSwitch, wie Vitrine) ========== -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="State" Text="Aus" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" MinWidth="22" TextAlignment="Right"/>
                        <Grid Width="40" Height="20">
                            <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource ControlOff}"
                                    BorderBrush="{DynamicResource ControlOffStroke}" BorderThickness="1"/>
                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource Knob}"
                                     HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            <Setter TargetName="State" Property="Text" Value="Ein"/>
                            <!-- Ohne Animation fest verschoben, damit auch Screenshots den Endzustand zeigen -->
                            <Setter TargetName="Knob" Property="Margin" Value="24,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="14"/>
                            <Setter TargetName="Knob" Property="Height" Value="14"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Knob" Property="Margin" Value="3,0,0,0"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Knob" Property="Margin" Value="23,0,0,0"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Navigation links (wie Vitrine, plus Abzeichen) ========== -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="nav"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent"/>
                        <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                        <Grid Margin="14,0,10,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" Margin="0,0,14,0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            <Border x:Name="Badge" Grid.Column="2" CornerRadius="9" MinWidth="24" Height="18" Padding="6,0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <TextBlock x:Name="BadgeText" Text="{Binding (ui:Nav.Badge), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:Nav.Badge" Value="{x:Null}">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ui:Nav.Badge" Value="">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ui:Nav.BadgeTone" Value="Warnung">
                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Filter-Chips ========== -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="9,4,11,4"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="15" Padding="{TemplateBinding Padding}" BorderThickness="1"
                            Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtle}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ========== Karten ========== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="HeroCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HeroBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24,20"/>
        <Setter Property="Margin" Value="0,8,0,4"/>
    </Style>
    <!-- Kleine Kennzeichnung („deaktiviert“, „Vererbung unterbrochen“) -->
    <Style x:Key="TagBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="Margin" Value="0,0,6,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TagText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>
    <!-- ========== Einstellungszeile (wie Vitrine) ========== -->
    <Style TargetType="ui:SettingCard">
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:SettingCard">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,12" MinHeight="68">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="Ic" Text="{TemplateBinding Glyph}" Style="{StaticResource Icon}" FontSize="18"
                                       Margin="2,0,18,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource Body}"/>
                                <TextBlock x:Name="Desc" Text="{TemplateBinding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ContentPresenter x:Name="CP" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Glyph" Value="{x:Null}">
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Below">
                            <Setter TargetName="CP" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="CP" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="CP" Property="Grid.ColumnSpan" Value="2"/>
                            <Setter TargetName="CP" Property="Margin" Value="0,12,0,2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Lupe: Format-Etikett, Zahlenfeld, Ergebniszeilen ========== -->
    <Style x:Key="FormatTag" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="FormatTagText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Nummer einer Markierung (1, 2, …) – dieselbe Zahl steht im Bild am Code -->
    <Style x:Key="NumberBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="NumberBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Inhalt eines Codes: einzeilig, gekürzt, voller Text als Tooltip -->
    <Style x:Key="CodeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
    </Style>
    <!-- Seitenrahmen der Einstellungen und Info: gleicher Rand wie die Kopfzeile -->
    <Style x:Key="PageScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Padding" Value="36,0,30,28"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- Ergebniszeile (Kamera, Bildschirm, Datei, Auswahl): Nummer der Markierung, Format, Inhalt, Knöpfe.
         Die Knöpfe lösen CodeCommands aus; jede Seite bindet sie selbst. -->
    <DataTemplate x:Key="CodeRow" DataType="{x:Type svc:CodeItem}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource NumberBadge}" Margin="0,0,10,0"
                    Visibility="{Binding NumberText, Converter={StaticResource EmptyToVisible}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource NumberBadgeText}" Text="{Binding NumberText}"/>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource FormatTag}" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource FormatTagText}" Text="{Binding FormatLabel}"/>
            </Border>
            <TextBlock Grid.Column="2" Style="{StaticResource CodeText}" Text="{Binding OneLine}" ToolTip="{Binding ToolTipText}"/>
            <Button Grid.Column="3" Margin="12,0,0,0" Command="{x:Static ui:CodeCommands.Copy}" CommandParameter="{Binding}"
                    ToolTip="Inhalt in die Zwischenablage kopieren" AutomationProperties.Name="Kopieren">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Kopieren" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Margin="6,0,0,0" Command="{x:Static ui:CodeCommands.OpenLink}" CommandParameter="{Binding}"
                    ToolTip="{Binding LinkText}" AutomationProperties.Name="Link öffnen"
                    Visibility="{Binding HasLink, Converter={StaticResource BoolToVisible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Link öffnen" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
