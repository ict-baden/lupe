<!-- Ergänzt Fluent.Light.xaml um die wenigen Lupe-eigenen Farben -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Eigener Kippschalter (Stil „ToggleSwitch“ in Controls.xaml), wie Vitrine und Zutritt -->
    <SolidColorBrush x:Key="ControlOff" Color="#06000000"/>
    <SolidColorBrush x:Key="ControlOffStroke" Color="#72000000"/>
    <SolidColorBrush x:Key="Knob" Color="#9E000000"/>

    <SolidColorBrush x:Key="Good" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="GoodBg" Color="#1A0F7B0F"/>
    <SolidColorBrush x:Key="Bad" Color="#C42B1C"/>

    <!-- Sucher (Kamerabild, Vorschau): auch im hellen Theme dunkel, damit Bilder ruhig wirken -->
    <SolidColorBrush x:Key="ViewfinderBackground" Color="#FF202020"/>
    <SolidColorBrush x:Key="ViewfinderText" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="ViewfinderTextSecondary" Color="#A0FFFFFF"/>
    <SolidColorBrush x:Key="DropZoneBackground" Color="#08000000"/>
    <SolidColorBrush x:Key="DropZoneStroke" Color="#40000000"/>

    <!-- Kleine Fenster (Auswahl mehrerer Codes, Ergebnis-Hinweis): undurchsichtig, wie Vitrines Flyout -->
    <SolidColorBrush x:Key="FlyoutBackground" Color="#FFF9F9F9"/>

    <!-- Kopfkarte (Verlauf im Produkt-Akzent Orange-Rot des Symbols, dezent) -->
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2EF7A531" Offset="0"/>
        <GradientStop Color="#1AE8505B" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
