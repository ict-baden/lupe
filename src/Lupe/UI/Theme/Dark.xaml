<!-- Ergänzt Fluent.Dark.xaml um die wenigen Lupe-eigenen Farben -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ControlOff" Color="#00000000"/>
    <SolidColorBrush x:Key="ControlOffStroke" Color="#9AFFFFFF"/>
    <SolidColorBrush x:Key="Knob" Color="#D0FFFFFF"/>

    <SolidColorBrush x:Key="Good" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="GoodBg" Color="#266CCB5F"/>
    <SolidColorBrush x:Key="Bad" Color="#FF99A4"/>

    <SolidColorBrush x:Key="ViewfinderBackground" Color="#FF161616"/>
    <SolidColorBrush x:Key="ViewfinderText" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="ViewfinderTextSecondary" Color="#A0FFFFFF"/>
    <SolidColorBrush x:Key="DropZoneBackground" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="DropZoneStroke" Color="#50FFFFFF"/>

    <!-- Kleine Fenster (Auswahl mehrerer Codes, Ergebnis-Hinweis): undurchsichtig, wie Vitrines Flyout -->
    <SolidColorBrush x:Key="FlyoutBackground" Color="#FF2C2C2C"/>

    <!-- Kopfkarte (Verlauf im Produkt-Akzent Orange-Rot des Symbols, dezent) -->
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#33F7A531" Offset="0"/>
        <GradientStop Color="#1FE8505B" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
