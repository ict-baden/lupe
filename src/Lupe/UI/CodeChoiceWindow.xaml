<Window x:Class="Lupe.UI.CodeChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Lupe.Services"
        Title="Lupe – Code wählen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" SizeToContent="Height" Width="520"
        WindowStartupLocation="Manual" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Border x:Name="Card" Margin="16" CornerRadius="10" Background="{DynamicResource FlyoutBackground}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" Direction="270"/>
        </Border.Effect>
        <StackPanel Margin="18,14,14,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Lupe;component/Assets/lupe.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="Mehrere Codes gefunden" Style="{StaticResource BodyStrong}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Style="{DynamicResource GhostButton}" Click="Cancel_Click" ToolTip="Abbrechen (Esc)" AutomationProperties.Name="Abbrechen">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                </Button>
            </Grid>
            <TextBlock x:Name="ExplainText" Style="{StaticResource Caption}" FontSize="13" Margin="0,6,4,0"/>

            <ListBox x:Name="List" Margin="-4,12,0,0" MaxHeight="330" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="List_MouseDoubleClick"
                     AutomationProperties.Name="Gefundene Codes">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type svc:CodeItem}">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource NumberBadge}" Margin="0,0,12,0" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource NumberBadgeText}" Text="{Binding NumberText}"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding FormatLabel}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding OneLine}" Style="{StaticResource CodeText}" ToolTip="{Binding ToolTipText}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Click="CopyAll_Click" ToolTip="Alle Codes zeilenweise in die Zwischenablage">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Alle kopieren" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Content="Abbrechen" Click="Cancel_Click" IsCancel="True" MinWidth="96"/>
                <Button Grid.Column="3" Style="{DynamicResource AccentButton}" Click="Take_Click" IsDefault="True" Margin="8,0,0,0" MinWidth="120">
                    <TextBlock x:Name="TakeText" Text="Übernehmen"/>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
