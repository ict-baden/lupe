<Window x:Class="Lupe.UI.ResultToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lupe – Ergebnis" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False" SizeToContent="Height" Width="420"
        WindowStartupLocation="Manual" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Border x:Name="Card" Margin="16" CornerRadius="10" Background="{DynamicResource FlyoutBackground}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" Direction="270"/>
        </Border.Effect>
        <StackPanel Margin="16,12,12,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconCircle" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock x:Name="IconGlyph" Text="&#xED14;" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="QR-Code erkannt" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleText" Text="Lupe · Bildschirm" Style="{StaticResource Caption}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{DynamicResource GhostButton}" Click="Close_Click" VerticalAlignment="Top" ToolTip="Schließen"
                        AutomationProperties.Name="Schließen">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                </Button>
            </Grid>

            <TextBlock x:Name="ContentText" Style="{StaticResource Body}" Margin="0,10,4,0" MaxHeight="64" TextTrimming="CharacterEllipsis"/>
            <StackPanel x:Name="DoneRow" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                <TextBlock x:Name="DoneText" Style="{StaticResource Caption}" FontSize="13"/>
            </StackPanel>
            <TextBlock x:Name="ProblemText" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,6,0,0"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="CopyButton" Click="Copy_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Kopieren" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="LinkButton" Click="Link_Click" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Link öffnen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="Open_Click" Margin="6,0,0,0" Style="{DynamicResource GhostButton}">
                    <TextBlock Text="In Lupe zeigen" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
