<UserControl x:Class="Lupe.UI.Pages.ScreenPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lupe.UI">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
            <!-- ========== Kopf: großer Knopf und Tastenkürzel ========== -->
            <Border Style="{StaticResource HeroCard}" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Code auf dem Bildschirm?" Style="{StaticResource SubtitleText}"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Lupe blendet sich kurz aus, Sie ziehen ein Rechteck um den Code – fertig. Funktioniert über alle Monitore, mit Rechnungen, Webseiten, Videokonferenzen und Fotos."/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="Tastenkürzel" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ItemsControl x:Name="HotkeyKeys" Focusable="False" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" BorderThickness="1,1,1,2" Padding="9,3" Margin="0,0,5,0" MinWidth="30"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="HotkeyNote" Text="aus jedem Programm" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <Button Style="{StaticResource LinkButton}" Content="ändern" Margin="10,0,0,0" VerticalAlignment="Center" Click="GoSettings_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="ScanButton" Grid.Column="1" Style="{DynamicResource AccentButton}" Height="52" MinWidth="230" Padding="22,0"
                            VerticalAlignment="Center" Click="Scan_Click" AutomationProperties.Name="Ausschnitt scannen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A8;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Ausschnitt scannen" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Tastenkürzel belegt -->
            <Border x:Name="HotkeyWarning" Style="{StaticResource Card}" Visibility="Collapsed"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Tastenkürzel nicht verfügbar" Style="{StaticResource BodyStrong}"/>
                        <TextBlock x:Name="HotkeyWarningText" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Anderes wählen" Click="GoSettings_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- ========== So geht's ========== -->
            <TextBlock Text="So geht’s" Style="{StaticResource SectionText}"/>
            <UniformGrid Columns="3" Margin="-4,0,-4,0">
                <Border Style="{StaticResource Card}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="1  Tastenkürzel drücken" Style="{StaticResource BodyStrong}"/>
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0"
                                   Text="In jedem Programm – auch wenn Lupe nur im Infobereich läuft. Oder hier auf den Knopf."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="2  Rechteck aufziehen" Style="{StaticResource BodyStrong}"/>
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0"
                                   Text="Mit der Maus um den Code. Ein Klick ohne Ziehen nimmt den ganzen Bildschirm, Esc bricht ab."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="3  Ergebnis verwenden" Style="{StaticResource BodyStrong}"/>
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0"
                                   Text="Laut Einstellungen kopiert, in das vorherige Fenster getippt oder als Link geöffnet. Mehrere Codes: Auswahl."/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <ui:SettingCard Glyph="&#xE945;" Header="Bei einem Treffer" x:Name="ActionsCard" Margin="0,8,0,4">
                <Button Content="Ändern" Click="GoSettings_Click"/>
            </ui:SettingCard>

            <!-- ========== Zuletzt erkannt ========== -->
            <TextBlock Text="Zuletzt vom Bildschirm" Style="{StaticResource SectionText}"/>
            <Border Style="{StaticResource Card}" Padding="16,10">
                <StackPanel>
                    <TextBlock x:Name="ResultsEmpty" Text="Noch nichts gescannt." Style="{StaticResource Body}" Margin="0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ItemsControl x:Name="ResultList" ItemTemplate="{StaticResource CodeRow}" Focusable="False"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
