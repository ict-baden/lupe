<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lupe.UI"
             xmlns:l="clr-namespace:Lupe.Core.Resources;assembly=Lupe.Core"
             x:Class="Lupe.UI.Pages.InfoPage">
    <ScrollViewer Classes="page">
        <StackPanel MaxWidth="1000">
            <Border Classes="card" Padding="24" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="avares://Lupe/Assets/lupe.png" Width="64" Height="64" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Lupe" Classes="subtitle"/>
                        <TextBlock x:Name="VersionText" Classes="caption"/>
                        <TextBlock Text="{x:Static l:Strings.Page_Info_Tagline}" Classes="caption"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ui:SettingCard Glyph="&#xE7EF;" Header="{x:Static l:Strings.Page_Info_Publisher}" Description="ICT-Baden">
                <TextBlock/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE8D7;" Header="{x:Static l:Strings.Page_Info_License}" Description="{x:Static l:Strings.Page_Info_LicenseMit}">
                <Button Click="OpenLicense_Click" AutomationProperties.Name="{x:Static l:Strings.Page_Info_LicenseOpenName}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" Classes="glyph"/>
                        <TextBlock Text="{x:Static l:Strings.Page_Info_ShowText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE71B;" Header="{x:Static l:Strings.Page_Info_Website}" Description="ict-baden.de">
                <Button Click="OpenWebsite_Click" AutomationProperties.Name="{x:Static l:Strings.Page_Info_WebsiteOpenName}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" Classes="glyph"/>
                        <TextBlock Text="{x:Static l:Strings.Page_Info_OpenInBrowser}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE7EF;" Header="{x:Static l:Strings.Page_Info_Imprint}" Description="{x:Static l:Strings.Page_Info_ImprintText}">
                <Button Click="OpenImprint_Click" AutomationProperties.Name="{x:Static l:Strings.Page_Info_ImprintOpenName}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" Classes="glyph"/>
                        <TextBlock Text="{x:Static l:Strings.Page_Info_OpenInBrowser}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE71B;" Header="{x:Static l:Strings.Page_Info_SourceCode}" Description="github.com/ict-baden/lupe">
                <Button Click="OpenRepository_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" Classes="glyph"/>
                        <TextBlock Text="{x:Static l:Strings.Page_Info_OpenInBrowser}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xED14;" Header="{x:Static l:Strings.Page_Info_Components}"
                            Description="{x:Static l:Strings.Page_Info_ComponentsText}">
                <Button Click="OpenNotices_Click" AutomationProperties.Name="{x:Static l:Strings.Page_Info_LicenseTextsName}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" Classes="glyph"/>
                        <TextBlock Text="{x:Static l:Strings.Page_Info_LicenseTexts}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE72E;" Header="{x:Static l:Strings.Page_Info_Privacy}" Description="{x:Static l:Strings.Page_Info_PrivacyText}">
                <Button Click="OpenPrivacy_Click" AutomationProperties.Name="{x:Static l:Strings.Page_Info_PrivacyOpenName}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" Classes="glyph"/>
                        <TextBlock Text="{x:Static l:Strings.Page_Info_OpenInBrowser}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE946;" Header="{x:Static l:Strings.Page_Info_Support}" Description="{x:Static l:Strings.Page_Info_SupportText}">
                <Button Click="OpenSupport_Click" AutomationProperties.Name="{x:Static l:Strings.Page_Info_SupportOpenName}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" Classes="glyph"/>
                        <TextBlock Text="{x:Static l:Strings.Page_Info_OpenInBrowser}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE8E5;" Header="{x:Static l:Strings.Page_Info_YourData}" x:Name="DataCard">
                <Button x:Name="DataButton" Click="OpenData_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Classes="glyph"/>
                        <TextBlock Text="{x:Static l:Strings.Page_Shared_OpenFolder}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ui:SettingCard>

            <TextBlock Text="{x:Static l:Strings.Page_Info_CommandLine}" Classes="section"/>
            <Border Classes="card" Padding="20,16">
                <StackPanel>
                    <TextBlock x:Name="CommandIntro" Classes="body" Text="{x:Static l:Strings.Page_Info_CommandIntroWindows}"/>
                    <TextBox x:Name="CommandExample" IsReadOnly="True" FontFamily="{DynamicResource MonoFont}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                             AutomationProperties.Name="{x:Static l:Strings.Page_Info_CommandExampleName}"/>
                    <Grid Margin="0,12,0,0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Text="{x:Static l:Strings.Page_Info_ExitCode0}" Classes="bodyStrong" FontSize="13" Margin="0,0,16,4"/>
                        <TextBlock Grid.Column="1" Text="{x:Static l:Strings.Page_Info_ExitCode0Text}" Classes="body" FontSize="13"/>
                        <TextBlock Grid.Row="1" Text="{x:Static l:Strings.Page_Info_ExitCode1}" Classes="bodyStrong" FontSize="13" Margin="0,0,16,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static l:Strings.Page_Info_ExitCode1Text}" Classes="body" FontSize="13"/>
                        <TextBlock Grid.Row="2" Text="{x:Static l:Strings.Page_Info_ExitCode3}" Classes="bodyStrong" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static l:Strings.Page_Info_ExitCode3Text}" Classes="body" FontSize="13"/>
                    </Grid>
                    <TextBlock x:Name="CommandHelp" Classes="caption" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Static l:Strings.Page_Info_Keyboard}" Classes="section"/>
            <Border Classes="card" Padding="20,14">
                <TextBlock x:Name="KeysText" Classes="body" FontSize="13" LineHeight="22"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
