<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:Lupe.UI.Pages"
             xmlns:l="clr-namespace:Lupe.Core.Resources;assembly=Lupe.Core"
             x:Class="Lupe.UI.Pages.HistoryPage">
    <Grid Margin="36,0,36,20" RowDefinitions="Auto,Auto,*,Auto">

        <!-- ========== Suche und Export ========== -->
        <Grid Margin="0,0,0,12" ColumnDefinitions="280,*,Auto,Auto">
            <TextBox x:Name="SearchBox" VerticalAlignment="Center" TextChanged="Search_TextChanged" PlaceholderText="{x:Static l:Strings.Page_History_SearchPlaceholder}"
                     AutomationProperties.Name="{x:Static l:Strings.Page_History_SearchName}">
                <TextBox.InnerRightContent>
                    <TextBlock Text="&#xE721;" Classes="icon" FontSize="13" Margin="0,0,11,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
                </TextBox.InnerRightContent>
            </TextBox>
            <TextBlock x:Name="CountText" Grid.Column="1" Classes="caption" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="ExportButton" Grid.Column="2" Click="Export_Click" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" Classes="glyph"/>
                    <TextBlock Text="{x:Static l:Strings.Page_History_ExportCsv}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="ClearButton" Grid.Column="3" Click="Clear_Click" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Classes="glyph"/>
                    <TextBlock Text="{x:Static l:Strings.Page_History_ClearAll}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1">
            <!-- Verlaufsdatei kaputt, gesperrt oder nicht speicherbar -->
            <Border x:Name="ProblemNotice" Classes="card caution" IsVisible="False" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="&#xE7BA;" Classes="icon" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static l:Strings.Page_History_ProblemTitle}" Classes="bodyStrong"/>
                        <TextBlock x:Name="ProblemText" Classes="caption" FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Verlauf ausgeschaltet -->
            <Border x:Name="OffNotice" Classes="card" IsVisible="False" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="&#xE946;" Classes="icon" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static l:Strings.Page_History_OffTitle}" Classes="bodyStrong"/>
                        <TextBlock Classes="caption" FontSize="13" Margin="0,2,0,0"
                                   Text="{x:Static l:Strings.Page_History_OffText}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{x:Static l:Strings.Page_History_GoSettings}" Click="GoSettings_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ========== Liste ========== -->
        <Border Grid.Row="2" Classes="card" Padding="0" Margin="0">
            <Grid RowDefinitions="Auto,*">
                <!-- Spaltenköpfe: Klick sortiert, zweiter Klick dreht um -->
                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="4,0">
                    <Grid x:Name="HeaderGrid" ColumnDefinitions="150,150,120,*" Height="34">
                        <Button x:Name="SortTime" Classes="header" Tag="Time" Click="Sort_Click" Content="{x:Static l:Strings.Page_History_ColumnTime}"/>
                        <Button x:Name="SortSource" Grid.Column="1" Classes="header" Tag="SourceLabel" Click="Sort_Click" Content="{x:Static l:Strings.Page_History_ColumnSource}"/>
                        <Button x:Name="SortFormat" Grid.Column="2" Classes="header" Tag="FormatLabel" Click="Sort_Click" Content="{x:Static l:Strings.Page_History_ColumnFormat}"/>
                        <Button x:Name="SortText" Grid.Column="3" Classes="header" Tag="OneLine" Click="Sort_Click" Content="{x:Static l:Strings.Page_History_ColumnContent}"/>
                    </Grid>
                </Border>
                <ListBox x:Name="HistoryList" Grid.Row="1" Classes="table" SelectionMode="Single" SelectionChanged="List_SelectionChanged"
                         DoubleTapped="List_DoubleTapped" KeyDown="List_KeyDown" AutomationProperties.Name="{x:Static l:Strings.Page_Shared_History}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static l:Strings.Page_Shared_Copy}" Click="Copy_Click" InputGesture="Ctrl+C"/>
                            <MenuItem x:Name="MenuOpenLink" Header="{x:Static l:Strings.Page_Shared_OpenLink}" Click="OpenLink_Click"/>
                            <Separator/>
                            <MenuItem Header="{x:Static l:Strings.Page_History_DeleteEntry}" Click="Delete_Click" InputGesture="Delete"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="pages:HistoryRow">
                            <Grid ColumnDefinitions="150,150,120,*" Background="Transparent">
                                <TextBlock Text="{Binding TimeText}" Classes="cell" Margin="8,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,10,0">
                                    <TextBlock Text="{Binding SourceGlyph}" Classes="icon" FontSize="13" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SourceLabel}" Classes="cell"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding FormatLabel}" Classes="cell" Margin="8,0,10,0"/>
                                <DockPanel Grid.Column="3" Margin="8,0,10,0">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE71B;" Classes="icon" FontSize="12" Margin="0,0,6,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" ToolTip.Tip="{Binding LinkText}"
                                               IsVisible="{Binding HasLink}"/>
                                    <TextBlock Text="{Binding OneLine}" Classes="cell" ToolTip.Tip="{Binding Text}"/>
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyHint" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsVisible="False">
                    <TextBlock Text="&#xE81C;" FontFamily="{DynamicResource IconFont}" FontSize="36" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="EmptyTitle" Text="{x:Static l:Strings.Page_History_EmptyTitle}" Classes="subtitle" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock x:Name="EmptyText" Classes="caption" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"
                               Text="{x:Static l:Strings.Page_History_EmptyText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== Gewählter Eintrag ========== -->
        <Border x:Name="DetailBar" Grid.Row="3" Classes="card" Margin="0,12,0,0" Padding="16,12" IsEnabled="False">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="DetailTitle" Text="{x:Static l:Strings.Page_History_NoSelection}" Classes="bodyStrong" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <TextBlock x:Name="DetailText" Classes="caption" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="Copy_Click" AutomationProperties.Name="{x:Static l:Strings.Page_Shared_Copy}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Classes="glyph"/>
                            <TextBlock Text="{x:Static l:Strings.Page_Shared_Copy}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenLinkButton" Click="OpenLink_Click" Margin="6,0,0,0" AutomationProperties.Name="{x:Static l:Strings.Page_Shared_OpenLink}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" Classes="glyph"/>
                            <TextBlock Text="{x:Static l:Strings.Page_Shared_OpenLink}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Delete_Click" Margin="6,0,0,0" ToolTip.Tip="{x:Static l:Strings.Page_History_DeleteEntryTip}" AutomationProperties.Name="{x:Static l:Strings.Page_History_DeleteEntry}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Classes="glyph"/>
                            <TextBlock Text="{x:Static l:Strings.Page_History_Delete}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
