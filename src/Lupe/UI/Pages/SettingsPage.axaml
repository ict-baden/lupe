<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lupe.UI"
             xmlns:pages="clr-namespace:Lupe.UI.Pages"
             xmlns:l="clr-namespace:Lupe.Core.Resources;assembly=Lupe.Core"
             x:Class="Lupe.UI.Pages.SettingsPage">
    <ScrollViewer x:Name="Scroller" Classes="page">
        <StackPanel MaxWidth="1000">

            <!-- Einstellungsdatei kaputt, gesperrt oder Änderung nicht gespeichert -->
            <Border x:Name="ProblemNotice" Classes="card caution" IsVisible="False" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="&#xE7BA;" Classes="icon" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static l:Strings.Page_Settings_ProblemTitle}" Classes="bodyStrong"/>
                        <TextBlock x:Name="ProblemText" Classes="caption" FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Fehlende Berechtigungen oder Systemfunktionen (macOS: Kamera, Bildschirmaufnahme, Bedienungshilfen …) -->
            <ItemsControl x:Name="PlatformProblems" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pages:ProblemRow">
                        <Border Classes="card caution" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="&#xE7BA;" Classes="icon" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Classes="bodyStrong"/>
                                    <TextBlock Text="{Binding Message}" Classes="caption" FontSize="13" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="{x:Static l:Strings.Page_Settings_SystemSettings}" Click="OpenSystemSettings_Click" Margin="12,0,0,0"
                                        VerticalAlignment="Center" IsVisible="{Binding HasLink}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ========== Aktionen ========== -->
            <TextBlock Text="{x:Static l:Strings.Page_Shared_OnHit}" Classes="section" Margin="2,0,0,8"/>
            <ui:SettingCard Glyph="&#xE722;" Header="{x:Static l:Strings.Page_Settings_CameraActions}" x:Name="CameraActionsCard"
                            Description="{x:Static l:Strings.Page_Settings_CameraActionsText}">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="ActCopy" Content="{x:Static l:Strings.Page_Shared_Copy}" Click="Actions_Click" Margin="0,0,20,0" MinWidth="0"/>
                    <CheckBox x:Name="ActType" Content="{x:Static l:Strings.Page_Settings_Type}" Click="Actions_Click" Margin="0,0,20,0" MinWidth="0"/>
                    <CheckBox x:Name="ActLink" Content="{x:Static l:Strings.Page_Shared_OpenLink}" Click="Actions_Click" MinWidth="0"/>
                </StackPanel>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE7F4;" Header="{x:Static l:Strings.Page_Settings_ScreenActions}"
                            Description="{x:Static l:Strings.Page_Settings_ScreenActionsText}">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="ScrCopy" Content="{x:Static l:Strings.Page_Shared_Copy}" Click="Actions_Click" Margin="0,0,20,0" MinWidth="0"/>
                    <CheckBox x:Name="ScrType" Content="{x:Static l:Strings.Page_Settings_Type}" Click="Actions_Click" Margin="0,0,20,0" MinWidth="0"/>
                    <CheckBox x:Name="ScrLink" Content="{x:Static l:Strings.Page_Shared_OpenLink}" Click="Actions_Click" MinWidth="0"/>
                </StackPanel>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE751;" Header="{x:Static l:Strings.Page_Settings_AfterTyping}"
                            Description="{x:Static l:Strings.Page_Settings_AfterTypingText}">
                <ComboBox x:Name="SuffixBox" Width="160" SelectionChanged="Suffix_SelectionChanged" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_AfterTypingName}">
                    <ComboBoxItem Content="{x:Static l:Strings.Page_Settings_SuffixNone}" Tag=""/>
                    <ComboBoxItem Content="{x:Static l:Strings.Core_Key_Enter}" Tag="Enter"/>
                    <ComboBoxItem Content="{x:Static l:Strings.Core_Key_Tab}" Tag="Tab"/>
                </ComboBox>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE916;" Header="{x:Static l:Strings.Page_Settings_TypeDelay}"
                            Description="{x:Static l:Strings.Page_Settings_TypeDelayText}">
                <ComboBox x:Name="DelayBox" Width="160" SelectionChanged="Delay_SelectionChanged" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_TypeDelay}">
                    <ComboBoxItem Content="{x:Static l:Strings.Page_Settings_DelayNone}" Tag="0"/>
                    <ComboBoxItem Content="{x:Static l:Strings.Page_Settings_DelayFast}" Tag="10"/>
                    <ComboBoxItem Content="{x:Static l:Strings.Page_Settings_DelayNormal}" Tag="20"/>
                    <ComboBoxItem Content="{x:Static l:Strings.Page_Settings_DelaySlow}" Tag="40"/>
                </ComboBox>
            </ui:SettingCard>

            <!-- ========== Tastenkürzel ========== -->
            <TextBlock Text="{x:Static l:Strings.Page_Settings_ScreenScan}" Classes="section"/>
            <ui:SettingCard Glyph="&#xE765;" Header="{x:Static l:Strings.Page_Shared_Hotkey}" x:Name="HotkeyCard"
                            Description="{x:Static l:Strings.Page_Settings_HotkeyTextWindows}">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True" TextAlignment="Center" Cursor="Hand"
                             AutomationProperties.Name="{x:Static l:Strings.Page_Settings_HotkeyName}"/>
                    <Button x:Name="HotkeyDefaultButton" Content="{x:Static l:Strings.Page_Settings_HotkeyDefault}" Margin="8,0,0,0" Click="HotkeyDefault_Click"/>
                </StackPanel>
            </ui:SettingCard>
            <Grid x:Name="HotkeyState" Margin="18,2,0,4" ColumnDefinitions="Auto,*">
                <TextBlock x:Name="HotkeyStateIcon" Text="&#xE73E;" Classes="icon" FontSize="12" Margin="0,3,8,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="HotkeyStateText" Grid.Column="1" Classes="caption" FontSize="13"/>
            </Grid>
            <!-- Strg+Alt+…: auf deutschen Tastaturen unter Windows dieselben Tasten wie AltGr -->
            <Grid x:Name="AltGrHint" Margin="18,2,0,4" IsVisible="False" ColumnDefinitions="Auto,*">
                <TextBlock Text="&#xE7BA;" Classes="icon" FontSize="12" Margin="0,3,8,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                <TextBlock x:Name="AltGrHintText" Grid.Column="1" Classes="caption" FontSize="13"/>
            </Grid>

            <!-- ========== Link-Regeln ========== -->
            <TextBlock Text="{x:Static l:Strings.Page_Settings_LinkRules}" Classes="section"/>
            <Border Classes="card" Padding="16,14">
                <StackPanel>
                    <TextBlock Classes="caption" FontSize="13" Margin="0,0,0,12"
                               Text="{x:Static l:Strings.Page_Settings_LinkRulesText}"/>
                    <Grid Margin="0,0,0,4" ColumnDefinitions="56,*,*,120">
                        <TextBlock Text="{x:Static l:Strings.Page_Settings_RuleActive}" Classes="caption"/>
                        <TextBlock Grid.Column="1" Text="{x:Static l:Strings.Page_Settings_RulePattern}" Classes="caption"/>
                        <TextBlock Grid.Column="2" Text="{x:Static l:Strings.Page_Settings_RulePrefixHeader}" Classes="caption" Margin="8,0,0,0"/>
                    </Grid>
                    <ItemsControl x:Name="RulesList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ui:RuleRow">
                                <StackPanel Margin="0,3">
                                    <Grid ColumnDefinitions="56,*,*,120">
                                        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{x:Static l:Strings.Page_Settings_RuleActiveName}" MinWidth="0"/>
                                        <TextBox Grid.Column="1" Text="{Binding Pattern}" FontFamily="{DynamicResource MonoFont}"
                                                 FontSize="13" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_RulePattern}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Prefix}" FontFamily="{DynamicResource MonoFont}"
                                                 FontSize="13" Margin="8,0,0,0" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_RulePrefix}"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Classes="ghost" Click="RuleUp_Click" ToolTip.Tip="{x:Static l:Strings.Page_Settings_RuleUpTip}" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_RuleUp}">
                                                <TextBlock Text="&#xE74A;" Classes="icon" FontSize="12"/>
                                            </Button>
                                            <Button Classes="ghost" Click="RuleDown_Click" ToolTip.Tip="{x:Static l:Strings.Page_Settings_RuleDown}" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_RuleDown}">
                                                <TextBlock Text="&#xE74B;" Classes="icon" FontSize="12"/>
                                            </Button>
                                            <Button Classes="ghost" Click="RuleDelete_Click" ToolTip.Tip="{x:Static l:Strings.Page_Settings_RuleDelete}" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_RuleDelete}">
                                                <TextBlock Text="&#xE74D;" Classes="icon" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" Margin="56,3,0,0"
                                               TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,10,0,0" ColumnDefinitions="Auto,Auto,*">
                        <Button Click="RuleAdd_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Classes="glyph" FontSize="12"/>
                                <TextBlock Text="{x:Static l:Strings.Page_Settings_RuleAdd}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="RuleTestBox" Grid.Column="1" Width="260" Margin="16,0,0,0" VerticalAlignment="Center" TextChanged="RuleTest_TextChanged"
                                 FontFamily="{DynamicResource MonoFont}" FontSize="13" PlaceholderText="{x:Static l:Strings.Page_Settings_RuleTest}"
                                 AutomationProperties.Name="{x:Static l:Strings.Page_Settings_RuleTest}"/>
                        <TextBlock x:Name="RuleTestResult" Grid.Column="2" Classes="caption" FontSize="13" Margin="12,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== Formate ========== -->
            <TextBlock Text="{x:Static l:Strings.Page_Settings_Formats}" Classes="section"/>
            <ui:SettingCard Glyph="&#xED14;" Header="{x:Static l:Strings.Page_Settings_AllFormats}"
                            Description="{x:Static l:Strings.Page_Settings_AllFormatsText}">
                <CheckBox x:Name="AllFormatsToggle" Classes="toggle" Click="AllFormats_Click" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_AllFormats}"/>
            </ui:SettingCard>
            <Border x:Name="FormatsCard" Classes="card" Padding="16,12">
                <WrapPanel x:Name="FormatsPanel"/>
            </Border>

            <!-- ========== Kamera ========== -->
            <TextBlock Text="{x:Static l:Strings.Page_Shared_Camera}" Classes="section"/>
            <ui:SettingCard Glyph="&#xE767;" Header="{x:Static l:Strings.Page_Settings_Sound}" Description="{x:Static l:Strings.Page_Settings_SoundText}">
                <StackPanel Orientation="Horizontal">
                    <Button Classes="ghost" Click="SoundTest_Click" ToolTip.Tip="{x:Static l:Strings.Page_Settings_SoundTest}" Margin="0,0,12,0" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_SoundTest}">
                        <TextBlock Text="&#xE768;" Classes="icon" FontSize="12"/>
                    </Button>
                    <CheckBox x:Name="SoundToggle" Classes="toggle" Click="Toggle_Click" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_Sound}"/>
                </StackPanel>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE71E;" Header="{x:Static l:Strings.Page_Shared_AimHelp}" Description="{x:Static l:Strings.Page_Settings_AimHelpText}">
                <CheckBox x:Name="AimToggle" Classes="toggle" Click="Toggle_Click" AutomationProperties.Name="{x:Static l:Strings.Page_Shared_AimHelp}"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE916;" Header="{x:Static l:Strings.Page_Settings_RepeatSuppress}"
                            Description="{x:Static l:Strings.Page_Settings_RepeatSuppressText}">
                <ComboBox x:Name="RepeatBox" Width="160" SelectionChanged="Repeat_SelectionChanged" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_RepeatSuppress}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="pages:RepeatChoice">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </ui:SettingCard>

            <!-- ========== Verlauf ========== -->
            <TextBlock Text="{x:Static l:Strings.Page_Shared_History}" Classes="section"/>
            <ui:SettingCard Glyph="&#xE81C;" Header="{x:Static l:Strings.Page_Settings_KeepHistory}" x:Name="KeepCard">
                <CheckBox x:Name="KeepToggle" Classes="toggle" Click="Toggle_Click" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_KeepHistory}"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE8FD;" Header="{x:Static l:Strings.Page_Settings_HistoryLimit}" Description="{x:Static l:Strings.Page_Settings_HistoryLimitText}">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="LimitBox" Width="110" TextAlignment="Right" LostFocus="Limit_LostFocus" KeyDown="Limit_KeyDown"
                             AutomationProperties.Name="{x:Static l:Strings.Page_Settings_HistoryLimitName}"/>
                    <TextBlock Text="{x:Static l:Strings.Page_Settings_Entries}" Classes="body" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </ui:SettingCard>

            <!-- ========== Start ========== -->
            <TextBlock Text="{x:Static l:Strings.Page_Settings_StartSection}" Classes="section"/>
            <ui:SettingCard Glyph="&#xE7E8;" Header="{x:Static l:Strings.Page_Settings_AutostartWindows}" x:Name="AutostartCard"
                            Description="{x:Static l:Strings.Page_Settings_AutostartText}">
                <CheckBox x:Name="AutostartToggle" Classes="toggle" Click="Autostart_Click" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_AutostartName}"/>
            </ui:SettingCard>
            <ui:SettingCard Glyph="&#xE73F;" Header="{x:Static l:Strings.Page_Settings_KeepInTray}"
                            Description="{x:Static l:Strings.Page_Settings_KeepInTrayText}">
                <CheckBox x:Name="TrayToggle" Classes="toggle" Click="Tray_Click" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_KeepInTrayName}"/>
            </ui:SettingCard>

            <!-- ========== Sprache ========== -->
            <ui:SettingCard Glyph="&#xE713;" Header="{x:Static l:Strings.Page_Settings_Language}" Description="{x:Static l:Strings.Page_Settings_LanguageHint}">
                <ComboBox x:Name="LanguageBox" Width="160" SelectionChanged="Language_SelectionChanged" AutomationProperties.Name="{x:Static l:Strings.Page_Settings_Language}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="pages:LanguageChoice">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </ui:SettingCard>

            <StackPanel Orientation="Horizontal" Margin="2,18,0,0">
                <TextBlock x:Name="StoreText" Classes="caption" FontSize="13" VerticalAlignment="Center"/>
                <Button Classes="link" Content="{x:Static l:Strings.Page_Shared_OpenFolder}" Margin="10,0,0,0" VerticalAlignment="Center" Click="OpenFolder_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
