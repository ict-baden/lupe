<UserControl x:Class="Lupe.UI.Pages.FilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lupe.UI"
             AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <Grid Margin="36,0,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== Bild holen ========== -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{DynamicResource AccentButton}" Click="Open_Click" AutomationProperties.Name="Bild öffnen">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Bild öffnen …" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Margin="8,0,0,0" Click="Paste_Click" ToolTip="Strg+V" AutomationProperties.Name="Aus Zwischenablage">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Aus Zwischenablage" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="SourceText" Grid.Column="2" Style="{StaticResource Caption}" FontSize="13" Margin="16,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="oder Strg+V · oder ein Bild hierher ziehen"/>
        </Grid>

        <!-- ========== Vorschau / Ablagefläche ========== -->
        <Border x:Name="DropArea" Grid.Row="1" CornerRadius="8" Background="{DynamicResource DropZoneBackground}" ClipToBounds="True">
            <Grid>
                <Rectangle x:Name="DropFrame" RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="5 4"
                           Stroke="{DynamicResource DropZoneStroke}" IsHitTestVisible="False"/>
                <ui:CodeView x:Name="View" Margin="12"/>
                <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="24">
                    <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="Bild hierher ziehen" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="440"
                               Text="Fotos, Scans und Bildschirmfotos – PNG, JPEG, BMP, GIF, TIFF und was Windows sonst lesen kann. Auch mehrere Codes in einem Bild."/>
                </StackPanel>
                <Border x:Name="BusyTag" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="6" Padding="14,8"
                        Background="#CC000000" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="BusyText" Text="Suche Codes …" Foreground="White" FontSize="14"/>
                </Border>
            </Grid>
        </Border>

        <!-- ========== Gefundene Codes ========== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResultTitle" Text="Gefundene Codes" Style="{StaticResource BodyStrong}" VerticalAlignment="Center"/>
                    <Button x:Name="CopyAllButton" Grid.Column="1" Style="{DynamicResource GhostButton}" Click="CopyAll_Click" Visibility="Collapsed"
                            ToolTip="Alle Codes zeilenweise kopieren">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Alle kopieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="ResultEmpty" Text="Noch kein Bild gelesen." Style="{StaticResource Body}" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="ResultList" ItemTemplate="{StaticResource CodeRow}" Margin="0,6,0,0" Focusable="False"/>
                </ScrollViewer>
                <TextBlock x:Name="ResultDone" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
