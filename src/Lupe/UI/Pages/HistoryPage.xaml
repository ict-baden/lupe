<UserControl x:Class="Lupe.UI.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lupe.UI">
    <Grid Margin="36,0,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== Suche und Export ========== -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" AutomationProperties.Name="Verlauf durchsuchen" Padding="10,5,30,6"/>
                <TextBlock Style="{StaticResource Placeholder}" Text="Inhalt, Format oder Quelle"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Right" Margin="0,0,11,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock x:Name="CountText" Grid.Column="1" Style="{StaticResource Caption}" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="ExportButton" Grid.Column="2" Click="Export_Click" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Als CSV exportieren …" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="ClearButton" Grid.Column="3" Click="Clear_Click" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Alles löschen" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Verlauf ausgeschaltet -->
        <Border x:Name="OffNotice" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Der Verlauf wird nicht gespeichert" Style="{StaticResource BodyStrong}"/>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0"
                               Text="Die Einträge hier gibt es nur, bis Lupe beendet wird – auf der Platte liegt nichts."/>
                </StackPanel>
                <Button Grid.Column="2" Content="Einstellungen" Click="GoSettings_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- ========== Liste ========== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <ListView x:Name="HistoryList" Style="{DynamicResource ListTable}" ui:ListTable.Columns="150, 150, 120, 1*:160"
                          SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"
                          AutomationProperties.Name="Verlauf">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Kopieren" Click="Copy_Click" InputGestureText="Strg+C"/>
                            <MenuItem x:Name="MenuOpenLink" Header="Link öffnen" Click="OpenLink_Click"/>
                            <Separator/>
                            <MenuItem Header="Eintrag löschen" Click="Delete_Click" InputGestureText="Entf"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Zeit" ui:ListTable.SortBy="Time">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource CellText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Quelle" ui:ListTable.SortBy="SourceLabel">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SourceGlyph}" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource CellText}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Format" ui:ListTable.SortBy="FormatLabel">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormatLabel}" Style="{StaticResource CellText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Inhalt" ui:ListTable.SortBy="OneLine">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" ToolTip="{Binding LinkText}"
                                                       Visibility="{Binding HasLink, Converter={StaticResource BoolToVisible}}"/>
                                            <TextBlock Text="{Binding OneLine}" Style="{StaticResource CellText}" ToolTip="{Binding Text}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="Collapsed">
                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="36" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="EmptyTitle" Text="Noch nichts erkannt" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"
                               Text="Alles, was Lupe per Kamera, Bildschirm oder Datei liest, steht hier."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== Gewählter Eintrag ========== -->
        <Border x:Name="DetailBar" Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12" IsEnabled="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="DetailTitle" Text="Kein Eintrag gewählt" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DetailText" Style="{StaticResource Caption}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="Copy_Click" AutomationProperties.Name="Kopieren">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Kopieren" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenLinkButton" Click="OpenLink_Click" Margin="6,0,0,0" AutomationProperties.Name="Link öffnen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Link öffnen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Delete_Click" Margin="6,0,0,0" ToolTip="Eintrag löschen (Entf)" AutomationProperties.Name="Eintrag löschen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Löschen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
