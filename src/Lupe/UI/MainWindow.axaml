<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lupe.UI"
        xmlns:l="clr-namespace:Lupe.Core.Resources;assembly=Lupe.Core"
        x:Class="Lupe.UI.MainWindow"
        Title="Lupe" Width="1100" Height="740" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}" UseLayoutRounding="True"
        Icon="avares://Lupe/Assets/lupe.ico">
    <Grid x:Name="Root" ColumnDefinitions="250,*">

        <!-- ===================== Navigation ===================== -->
        <DockPanel Margin="12,12,8,12">
            <!-- Grid statt waagerechtem StackPanel: Die Unterzeile bricht in längeren Sprachen um, statt in die Seite zu laufen -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="12,8,0,20">
                <Image Source="avares://Lupe/Assets/lupe.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppTitle" Text="Lupe" Classes="bodyStrong" FontSize="16"/>
                    <TextBlock Text="{x:Static l:Strings.App_Main_Tagline}" Classes="caption" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Tastenkürzel für den Bildschirm-Scan: bereit oder belegt -->
            <Border DockPanel.Dock="Top" Margin="4,0,4,14" CornerRadius="8" Padding="12,10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*">
                    <Border x:Name="StatusCircle" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock x:Name="StatusGlyph" Text="&#xE765;" Classes="icon" FontSize="16" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" Classes="bodyStrong" FontSize="13"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock x:Name="StatusDetail" Text="{x:Static l:Strings.App_Main_StatusReady}" Classes="caption"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom">
                <ui:NavButton x:Name="NavInfo" Glyph="&#xE946;" Content="{x:Static l:Strings.App_Nav_Info}"/>
            </StackPanel>

            <StackPanel>
                <ui:NavButton x:Name="NavCamera" Glyph="&#xE722;" Content="{x:Static l:Strings.App_Nav_Camera}"/>
                <ui:NavButton x:Name="NavScreen" Glyph="&#xE7F4;" Content="{x:Static l:Strings.App_Nav_Screen}"/>
                <ui:NavButton x:Name="NavFile" Glyph="&#xE8B9;" Content="{x:Static l:Strings.App_Nav_File}"/>
                <ui:NavButton x:Name="NavHistory" Glyph="&#xE81C;" Content="{x:Static l:Strings.App_Nav_History}"/>
                <ui:NavButton x:Name="NavSettings" Glyph="&#xE713;" Content="{x:Static l:Strings.App_Nav_Settings}"/>
            </StackPanel>
        </DockPanel>

        <!-- ===================== Inhalt ===================== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <StackPanel Margin="36,26,36,14">
                <TextBlock x:Name="PageTitle" Text="{x:Static l:Strings.App_Nav_Camera}" Classes="title"/>
                <TextBlock x:Name="PageSubtitle" Classes="caption" FontSize="13" Margin="1,2,0,0"/>
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>

            <!-- ===================== Meldungen (Fußleiste wie Vitrine und Zutritt) ===================== -->
            <Border x:Name="InfoBar" Grid.Row="2" IsVisible="False" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0" Padding="36,10,24,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock x:Name="InfoIcon" Text="&#xE946;" Classes="icon" FontSize="14" Margin="0,2,10,0" VerticalAlignment="Top"/>
                    <TextBlock x:Name="InfoText" Grid.Column="1" Classes="body" FontSize="13" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="ghost" Click="CloseInfo_Click" Margin="12,0,0,0" VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static l:Strings.App_Main_CloseNotice}" AutomationProperties.Name="{x:Static l:Strings.App_Main_CloseNotice}">
                        <TextBlock Text="&#xE711;" Classes="icon" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
