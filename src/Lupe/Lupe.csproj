<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lupe</RootNamespace>
    <AssemblyName>Lupe</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\lupe.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Company>ICT-Baden</Company>
    <Product>Lupe</Product>
    <Description>Liest QR- und Barcodes per Webcam, Bildschirmausschnitt, Datei oder Zwischenablage</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Eigener Einstiegspunkt (Program.Main): Befehlszeile ganz ohne WPF, sonst Oberfläche.
         App.xaml wird deshalb als normale Seite übersetzt, nicht als ApplicationDefinition mit eigenem Main. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lupe.Core\Lupe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\lupe.ico" />
    <Resource Include="Assets\lupe.png" />
  </ItemGroup>

  <!-- Lizenztexte der mitgelieferten Bibliotheken: neben Lupe.exe (ZIP, MSI) und eingebettet für die Info-Seite
       (die einzelne Lupe.exe zum Herunterladen hat keine Dateien daneben) -->
  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>
