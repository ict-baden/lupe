<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Zwei Ziele: net10.0-windows mit der Windows-Anbindung (MediaCapture, SendInput …), net10.0 mit den Anbindungen
         für Linux und macOS. Mit Runtime-Kennung (dotnet publish -r …) gilt nur das passende Ziel – so bleiben
         „dotnet publish src/Lupe/Lupe.csproj -r win-x64“ (Installer, CI) und „-r linux-x64“ ohne -f eindeutig. -->
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == ''">net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFramework Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('win'))">net10.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Lupe</RootNamespace>
    <AssemblyName>Lupe</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\lupe.ico</ApplicationIcon>
    <Version>0.1.1</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Liest QR- und Barcodes per Webcam, Bildschirmausschnitt, Datei oder Zwischenablage</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);LUPE_WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- Screenshots zeichnen ohne Bildschirm (auch in einer Dienst-Sitzung oder in CI ohne X-Server) -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lupe.Core\Lupe.Core.csproj" />
  </ItemGroup>

  <!-- Systemanbindung je Ziel: Windows-Build mit Lupe.Platform.Windows, sonst Linux und macOS (Wahl zur Laufzeit) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <ProjectReference Include="..\Lupe.Platform.Windows\Lupe.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\Lupe.Platform.Linux\Lupe.Platform.Linux.csproj" />
    <ProjectReference Include="..\Lupe.Platform.MacOS\Lupe.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Lizenztexte der mitgelieferten Bibliotheken: neben Lupe.exe (ZIP, MSI) und eingebettet für die Info-Seite
       (die einzelne Lupe.exe zum Herunterladen hat keine Dateien daneben) -->
  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
    <!-- Lupes eigene Lizenz ebenso: in jedem Paket neben dem Programm und für die Info-Seite eingebettet -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lupe.Tests" />
  </ItemGroup>

  <!-- SkiaSharp und HarfBuzzSharp bringen Debug-Symbole ihrer nativen Bibliotheken mit (gut 100 MB) – nicht ausliefern -->
  <Target Name="LupeOhneNativeSymbole" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' and $([System.String]::Copy('%(Filename)').StartsWith('lib'))" />
    </ItemGroup>
  </Target>

  <!-- Selbst gebaute zxing-cpp-Bibliothek statt der aus dem NuGet-Paket ZXingCpp (packaging/zxing/build.sh): Die aus dem
       Paket braucht glibc 2.38, macOS 26 bzw. die VC++-Laufzeit. CI veröffentlicht mit -p:LupeZXingDir=<ordner>, darin
       <rid>/ZXing.dll, libZXing.so oder libZXing.dylib. Ohne die Eigenschaft (Entwicklung, Tests) bleibt die aus dem Paket. -->
  <Target Name="LupeEigenesZXing" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(LupeZXingDir)' != ''">
    <PropertyGroup>
      <_LupeZXingName Condition="$(RuntimeIdentifier.StartsWith('win'))">ZXing.dll</_LupeZXingName>
      <_LupeZXingName Condition="$(RuntimeIdentifier.StartsWith('linux'))">libZXing.so</_LupeZXingName>
      <_LupeZXingName Condition="$(RuntimeIdentifier.StartsWith('osx'))">libZXing.dylib</_LupeZXingName>
      <_LupeZXingFile>$([System.IO.Path]::GetFullPath('$(LupeZXingDir)/$(RuntimeIdentifier)/$(_LupeZXingName)'))</_LupeZXingFile>
    </PropertyGroup>
    <Error Condition="'$(_LupeZXingName)' == ''" Text="LupeZXingDir: unbekannte Runtime-Kennung '$(RuntimeIdentifier)'" />
    <Error Condition="!Exists('$(_LupeZXingFile)')" Text="LupeZXingDir: $(_LupeZXingFile) fehlt (packaging/zxing/build.sh $(RuntimeIdentifier) …)" />
    <ItemGroup>
      <_LupeZXingAusPaket Include="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == '$(_LupeZXingName)'" />
    </ItemGroup>
    <Error Condition="'@(_LupeZXingAusPaket)' == ''" Text="LupeZXingDir: $(_LupeZXingName) aus dem NuGet-Paket ZXingCpp nicht unter den veröffentlichten Dateien – hat sich das Paket geändert?" />
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(_LupeZXingAusPaket)" />
      <!-- Gleiche Metadaten (RelativePath, AssetType …) wie die Datei aus dem Paket, nur eine andere Quelle -->
      <ResolvedFileToPublish Include="@(_LupeZXingAusPaket->'$(_LupeZXingFile)')" />
    </ItemGroup>
    <Message Importance="high" Text="zxing-cpp: $(_LupeZXingFile)" />
  </Target>
</Project>
