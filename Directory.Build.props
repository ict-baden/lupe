<Project>
  <!-- Gemeinsame Einstellungen für alle Projekte im Repo -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Firmierung wie im Impressum (https://ict-baden.de/impressum/), dieselbe wie AppInfo.Publisher -->
    <Company>ICT Baden GmbH</Company>
    <Product>Lupe</Product>
    <Copyright>© 2026 ICT Baden GmbH</Copyright>
    <!-- Strings.resx ist Englisch und Rückfallsprache, siehe docs/development.md („Languages“) -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Nur die Sprachen mitliefern, für die es Sprachdateien gibt (eigene und fremde Pakete), wie UiLanguage.Supported -->
    <SatelliteResourceLanguages>en;de;es;fr;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
