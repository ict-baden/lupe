# SPDX-License-Identifier: MIT
# Version der selbst gebauten zxing-cpp-Bibliothek (packaging/zxing/build.sh). Muss zur C-Schnittstelle passen, die
# das NuGet-Paket ZXingCpp aufruft: Beim Update von ZXingCpp in src/Lupe.Core/Lupe.Core.csproj hier den Tag und den
# Commit aus der .nuspec des Pakets (<repository commit="…">) übernehmen. check.sh prüft, dass beides zusammenpasst.
ZXINGCPP_NUGET=0.5.3
ZXING_REPO=https://github.com/zxing-cpp/zxing-cpp.git
ZXING_TAG=v3.1.1
ZXING_COMMIT=287c85df6f961c8efbfb5ffd736cd9457b8b890e
# macOS-Mindestversion beim Übersetzen (wie LSMinimumSystemVersion in packaging/macos/Info.plist)
MACOS_MIN=12.0
# Linux-Build mit glibc 2.28 (AlmaLinux 8 mit aktuellem GCC); feste Tags, damit der Build nachvollziehbar bleibt
MANYLINUX_X64=quay.io/pypa/manylinux_2_28_x86_64:2026.10.03-1
MANYLINUX_ARM64=quay.io/pypa/manylinux_2_28_aarch64:2026.10.03-1
