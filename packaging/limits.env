# SPDX-License-Identifier: MIT
# Älteste unterstützte Systeme, geprüft von packaging/check-natives.sh für jede mitgelieferte native Datei.
# macOS: LSMinimumSystemVersion in packaging/macos/Info.plist (zxing-cpp wird dafür gebaut, siehe packaging/zxing).
# Linux: höchste glibc- und libstdc++-Version, die eine Bibliothek verlangen darf (Debian 11, Ubuntu 20.04: glibc 2.31, GCC 10).
# Diese Grenze nennt auch die Doku (installation.md, error-codes.md, README.txt/LIESMICH.txt, Release-Text) – zusammen ändern.
GLIBC_MAX=2.31
GLIBCXX_MAX=3.4.28
