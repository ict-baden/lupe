<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    MSI für Lupe. Erwartet die veröffentlichten Programmdateien in $(PublishDir):
      dotnet publish src/Lupe/Lupe.csproj -c Release -r win-x64 -p:PublishSingleFile=true -o publish
      dotnet build installer/Lupe.Installer.wixproj -c Release -p:ProductVersion=0.1.3
  -->
  <PropertyGroup>
    <OutputName>Lupe</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.3</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\publish\</PublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir);AssetsDir=$(MSBuildThisFileDirectory)..\src\Lupe\Assets</DefineConstants>
    <!-- Bis 0.1.0 de-DE; das MSI ersetzt ältere Pakete trotzdem (MajorUpgrade IgnoreLanguage, siehe Package.wxs) -->
    <Cultures>en-US</Cultures>
    <!-- ICE38/43/57 schlagen bei Startmenü-Verknüpfungen in perMachine-Paketen fälschlich an (ALLUSERS=1 → Startmenü aller Benutzer).
         ICE61 warnt vor AllowSameVersionUpgrades, das ist hier gewollt (siehe Package.wxs).
         ICE60 bemängelt native DLLs ohne Sprache in der Versionsinfo – für Programm-DLLs bedeutungslos.
         ICE40 warnt vor REINSTALLMODE in der Property-Tabelle – gewollt (emus, siehe Package.wxs). -->
    <SuppressIces>ICE38;ICE40;ICE43;ICE57;ICE60;ICE61</SuppressIces>
    <!-- ICE-Prüfungen brauchen den Windows Installer-Dienst; auf CI-Runnern unnötig langsam/fehleranfällig -->
    <SuppressValidation Condition="'$(CI)' == 'true'">true</SuppressValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
